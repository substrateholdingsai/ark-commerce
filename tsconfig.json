{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*", "astro/src/*"],
      "@config/*": ["config/*"],
      "@worker/*": ["worker/*"],
      "@scripts/*": ["scripts/*"]
    },
    "types": ["@cloudflare/workers-types", "astro/client"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.astro",
    "worker/**/*",
    "config/**/*",
    "scripts/**/*",
    "astro/**/*"
  ],
  "exclude": ["node_modules", "dist", ".astro"]
}