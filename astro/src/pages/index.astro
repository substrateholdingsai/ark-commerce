---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/layout/Hero.astro";
import ProductCard from "../components/product/ProductCard.astro";
import CheckoutCalculator from "../components/checkout/CheckoutCalculator.astro";
import CartDrawer from "../components/checkout/CartDrawer.astro";
import { PRODUCTS } from "@/data/products";
import { config } from "../../config/config";
---

<Layout title={config.site.name} description={config.site.description}>
  
  <!-- 1. Hero (Tu componente adaptado) -->
  <Hero locale={config.site.language} />

  <!-- 2. Grid de Productos -->
  <section id="productos" class="max-w-[1160px] mx-auto px-4 pt-10 pb-6">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="font-display font-black text-[24px] sm:text-[30px] tracking-tight text-[#2B0E0A]">
          Elige tu ahumado
        </h2>
        <p class="text-sm text-[#7E1D0F]/60 mt-1 font-body">5 cortes • Listos para calentar y disfrutar</p>
      </div>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {PRODUCTS.map((product) => (
        <ProductCard product={product} client:visible />
      ))}
    </div>
  </section>

  <!-- 3. Checkout Calculator (Calculadora + Formulario) -->
  <CheckoutCalculator client:load />

  <!-- 4. Cart Drawer (Panel lateral del carrito) -->
  <CartDrawer client:load />

</Layout>