---
import Layout from "../layouts/Layout.astro";
import ProductExplorer from "../components/ProductExplorer.tsx";
import { config } from "../../config/config";
---

<Layout title="Productos - Temozonia" description="Explorador interactivo de productos">
  <main class="container">
    <header>
      <h1>Catálogo Interactivo</h1>
      <p>Demo de islas interactivas con React en Astro</p>
      <a href="/" class="back-link">← Volver al inicio</a>
    </header>

    <ProductExplorer client:visible />

    <section class="info">
      <h2>Cómo funciona</h2>
      <ul>
        <li>Este componente React se hidrata solo cuando es visible (<code>client:visible</code>)</li>
        <li>El estado del carrito se mantiene en el cliente</li>
        <li>No hay JavaScript innecesario en la carga inicial</li>
      </ul>
    </section>
  </main>

  <style>
    .container { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
    header { margin-bottom: 2rem; }
    header h1 { margin-bottom: 0.5rem; }
    .back-link { display: inline-block; margin-top: 1rem; color: #0066cc; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .info { margin-top: 3rem; padding: 1.5rem; background: #f1f5f9; border-radius: 0.5rem; }
    .info h2 { margin-bottom: 1rem; }
    .info ul { margin-left: 1.5rem; }
    .info li { margin: 0.5rem 0; }
    .info code { background: #e2e8f0; padding: 0.125rem 0.375rem; border-radius: 0.25rem; }
  </style>
</Layout>