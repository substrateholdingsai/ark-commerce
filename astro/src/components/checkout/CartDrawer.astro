---
// CartDrawer — Panel lateral del carrito
// Se abre desde el Header o al agregar un producto.
// Conectado al store Zustand (@/stores/cart.ts).
---

<div id="cart-drawer" class="fixed inset-0 z-50 hidden">

  <!-- ===== BACKDROP ===== -->
  <div
    id="cart-backdrop"
    class="absolute inset-0 bg-[#2B0E0A]/60 backdrop-blur-[2px]"
  ></div>

  <!-- ===== PANEL ===== -->
  <div
    class="absolute right-0 top-0 flex h-full w-[92%] flex-col bg-[#FFF9F3] shadow-[-20px_0_60px_rgba(0,0,0,0.25)] sm:w-[420px]"
  >

    <!-- Header -->
    <div class="flex h-[64px] items-center justify-between border-b border-[#7E1D0F]/10 px-5">
      <div class="flex items-center gap-2 font-black">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        Carrito • <span id="drawer-count">0</span> items
      </div>
      <button
        id="drawer-close"
        class="grid h-9 w-9 place-items-center rounded-full bg-[#2B0E0A] text-white transition hover:bg-black"
        aria-label="Cerrar carrito"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Items -->
    <div class="flex-1 space-y-3 overflow-y-auto p-4">

      <!-- Empty state -->
      <div id="drawer-empty" class="mt-10 text-center">
        <div class="mx-auto grid h-16 w-16 place-items-center rounded-full border border-[#7E1D0F]/10 bg-white">
          <svg class="h-7 w-7 text-[#FF8800]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
          </svg>
        </div>
        <div class="mt-4 font-black">Aún no hay humo</div>
        <div class="mt-1 text-sm text-[#7E1D0F]/60">
          Agrega tu primer kilo y te lo llevamos en <90 min
        </div>
      </div>

      <!-- Items list (se llena dinámicamente) -->
      <div id="drawer-items" class="space-y-3"></div>
    </div>

    <!-- Footer -->
    <div class="border-t border-[#7E1D0F]/10 bg-white p-4">
      <div class="flex items-center justify-between">
        <span class="text-xs font-black tracking-widest text-[#7E1D0F]/60">TOTAL</span>
        <span id="drawer-total" class="font-black text-[22px]" style="font-family:'Playfair Display',serif">
          $0 MXN
        </span>
      </div>
      <button
        id="drawer-pay"
        disabled
        class="mt-3 flex h-12 w-full items-center justify-center rounded-full bg-[#FF8800] text-sm font-black text-[#2B0E0A] transition disabled:cursor-not-allowed disabled:opacity-40 hover:brightness-105 active:scale-[0.98]"
      >
        Pagar Ahora • <span id="drawer-pay-total">$0</span>
      </button>
      <div class="mt-2 text-center text-[10px] text-[#7E1D0F]/50">
        4 pagos • Entrega Caucel • Sin apps
      </div>
    </div>
  </div>
</div>

<script>
  import { useCartStore } from '@/stores/cart';
  import { PRODUCTS } from '@/data/products';

  /* ── refs ── */
  const drawer     = document.getElementById('cart-drawer')!;
  const backdrop   = document.getElementById('cart-backdrop')!;
  const closeBtn   = document.getElementById('drawer-close')!;
  const itemsBox   = document.getElementById('drawer-items')!;
  const emptyBox   = document.getElementById('drawer-empty')!;
  const countEl    = document.getElementById('drawer-count')!;
  const totalEl    = document.getElementById('drawer-total')!;
  const payBtn     = document.getElementById('drawer-pay')! as HTMLButtonElement;
  const payTotalEl = document.getElementById('drawer-pay-total')!;

  /* ── render ── */
  const render = () => {
    const { items } = useCartStore.getState();
    const total = useCartStore.getState().getTotal();
    const count = useCartStore.getState().getItemCount();

    countEl.textContent    = String(count);
    totalEl.textContent    = `$${total} MXN`;
    payTotalEl.textContent = `$${total}`;

    if (items.length === 0) {
      emptyBox.classList.remove('hidden');
      itemsBox.innerHTML = '';
      payBtn.disabled = true;
      return;
    }

    emptyBox.classList.add('hidden');
    payBtn.disabled = false;

    itemsBox.innerHTML = items.map(item => {
      const p = PRODUCTS.find(pr => pr.id === item.id);
      if (!p) return '';
      return `
        <div class="flex gap-3 rounded-[16px] border border-[#7E1D0F]/10 bg-white p-3">
          <img src="${p.image}" alt="${p.name}"
               class="h-16 w-16 rounded-[12px] object-cover" />
          <div class="min-w-0 flex-1">
            <div class="truncate text-sm font-bold">${p.name}</div>
            <div class="text-xs text-[#7E1D0F]/60">${p.weight} · $${p.price}</div>
            <div class="mt-2 flex items-center gap-2">
              <button data-act="dec" data-id="${item.id}"
                class="grid h-7 w-7 place-items-center rounded-full border border-[#7E1D0F]/10 bg-[#FFF9F3] transition hover:bg-[#7E1D0F]/5">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                </svg>
              </button>
              <span class="w-5 text-center text-sm font-black">${item.qty}</span>
              <button data-act="inc" data-id="${item.id}"
                class="grid h-7 w-7 place-items-center rounded-full bg-[#2B0E0A] text-white transition hover:bg-black">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </button>
              <span class="ml-auto text-sm font-black">$${p.price * item.qty}</span>
            </div>
          </div>
        </div>`;
    }).join('');

    /* listeners de +/- */
    itemsBox.querySelectorAll('button[data-act]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id  = (btn as HTMLElement).dataset.id!;
        const act = (btn as HTMLElement).dataset.act!;
        useCartStore.getState().updateQuantity(id, act === 'inc' ? 1 : -1);
      });
    });
  };

  /* ── open / close ── */
  const open  = () => { drawer.classList.remove('hidden'); document.body.style.overflow = 'hidden'; };
  const close = () => { drawer.classList.add('hidden');    document.body.style.overflow = ''; };

  backdrop.addEventListener('click', close);
  closeBtn.addEventListener('click', close);

  /* botón "Pagar Ahora" → cierra drawer y scrollea al checkout */
  payBtn.addEventListener('click', () => {
    close();
    document.getElementById('checkout')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* evento global desde el Header */
  window.addEventListener('open-cart', open);

  /* ── suscripción al store ── */
  useCartStore.subscribe((state, prev) => {
    render();
    if (state.isCartOpen && !prev.isCartOpen) open();
  });

  /* ── init ── */
  render();
</script>