---
// src/components/layout/Header.astro
import { CONFIG } from '@/utils/constants';
---

<header class="sticky top-0 z-40 backdrop-blur-xl bg-[#FFF9F3]/90 border-b border-[#7E1D0F]/10 transition-all">
  <div class="max-w-[1160px] mx-auto px-4 h-[64px] flex items-center justify-between gap-4">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-[12px] bg-[#7E1D0F] text-white grid place-items-center font-black tracking-tighter font-display text-[18px] group-hover:scale-105 transition">
        T
      </div>
      <div class="leading-none">
        <div class="font-display font-black text-[18px] tracking-tight text-[#2B0E0A]">TEMOZONIA</div>
        <div class="text-[10px] font-bold tracking-[0.2em] text-[#7E1D0F]/70 -mt-0.5">CARNES AHUMADAS</div>
      </div>
      
      <!-- Status indicator (Desktop) -->
      <div class="hidden lg:flex items-center gap-2 ml-6 pl-6 border-l border-[#7E1D0F]/10">
        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
        <span class="text-xs font-semibold text-[#2B0E0A]/80">Ahumando ahora</span>
      </div>
    </a>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <a 
        href={`https://wa.me/${CONFIG.WHATSAPP}`}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-2 h-10 px-4 rounded-full bg-[#25D366] text-white font-bold text-sm hover:brightness-105 active:scale-[0.98] transition"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        WhatsApp
      </a>
      
      <!-- Cart Toggle Button -->
      <button 
        id="cart-toggle"
        class="relative inline-flex items-center gap-2 h-10 px-4 rounded-full bg-[#7E1D0F] text-white font-bold text-sm hover:bg-[#6A180D] active:scale-[0.98] transition"
        aria-label="Abrir carrito"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span class="hidden sm:inline">Carrito</span>
        <span id="cart-count" class="absolute -top-1 -right-1 min-w-[20px] h-5 px-1 rounded-full bg-[#FF8800] text-[#2B0E0A] text-[11px] grid place-items-center font-black hidden">
          0
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  import { useCartStore } from '@/stores/cart';
  
  const cartToggle = document.getElementById('cart-toggle');
  const cartCount = document.getElementById('cart-count');
  
  // Actualizar el badge del contador
  const updateCount = () => {
    const count = useCartStore.getState().getItemCount();
    if (count > 0) {
      cartCount!.textContent = count.toString();
      cartCount!.classList.remove('hidden');
    } else {
      cartCount!.classList.add('hidden');
    }
  };
  
  // Abrir drawer al hacer clic
  cartToggle?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cart'));
  });
  
  // Suscribirse a cambios en el carrito
  useCartStore.subscribe(updateCount);
  updateCount(); // Inicial
</script>