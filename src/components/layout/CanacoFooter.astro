---
// src/components/layout/CanacoFooter.astro — Footer dedicado a CANACO SERVYTUR Mérida
// HENEQUÉN design system: #FAF8F5 primario, #1A3A5C acento
---

<footer class="relative bg-canaco-accent border-t border-[#FAF8F5]/10 pt-16 pb-8 overflow-hidden text-[#FAF8F5]">
  <!-- Fondo decorativo sutil -->
  <div class="absolute inset-0 bg-[radial-gradient(rgba(250,248,245,0.05)_1px,transparent_1px)] bg-[size:30px_30px] opacity-30 pointer-events-none" />
  
  <div class="container mx-auto px-4 relative z-10 max-w-6xl">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-4 border-b border-[#FAF8F5]/10 pb-12">

      <!-- Columna 1: Branding -->
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded border border-[#FAF8F5]/20 bg-[#FAF8F5]/10 text-[#FAF8F5] shadow-[0_0_15px_rgba(250,248,245,0.2)]">
            <span class="font-serif font-bold text-xl">C</span>
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-bold tracking-tight text-[#FAF8F5] font-canaco">
              CANACO SERVYTUR
            </span>
            <span class="text-[10px] text-[#E9D8A6] font-mono uppercase tracking-widest">
              Mérida_Yucatán
            </span>
          </div>
        </div>
        
        <p class="font-canaco text-xs text-[#FAF8F5]/60 leading-relaxed">
          Cámara Nacional de Comercio, Servicios y Turismo de Mérida. Impulsando el desarrollo comercial del sureste desde 1926.
        </p>

        <!-- Badges de instituciones -->
        <div class="flex flex-wrap gap-2 mt-4">
          <span class="px-2.5 py-1 rounded bg-[#FAF8F5]/10 border border-[#FAF8F5]/20 text-[10px] font-canaco font-bold text-[#FAF8F5]/80">CANACO</span>
          <span class="px-2.5 py-1 rounded bg-[#FAF8F5]/10 border border-[#FAF8F5]/20 text-[10px] font-canaco font-bold text-[#FAF8F5]/80">SIEM</span>
          <span class="px-2.5 py-1 rounded bg-[#FAF8F5]/10 border border-[#FAF8F5]/20 text-[10px] font-canaco font-bold text-[#FAF8F5]/80">IMSS</span>
          <span class="px-2.5 py-1 rounded bg-[#FAF8F5]/10 border border-[#FAF8F5]/20 text-[10px] font-canaco font-bold text-[#FAF8F5]/80">SAT</span>
        </div>
      </div>

      <!-- Columna 2: Servicios Rápidos -->
      <div>
        <div class="flex items-center gap-2 mb-6">
          <svg class="h-4 w-4 text-[#E9D8A6]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002-2h2a2 2 0 012 2h2a2 2 0 01-2-2M9 5a2 2 0 012-2h2a2 2 0 01-2-2"/>
          </svg>
          <h4 class="text-xs font-bold uppercase tracking-widest text-[#FAF8F5] font-mono">
            /Servicios
          </h4>
        </div>
        <ul class="space-y-4 font-canaco text-sm">
          <li>
            <a href="/canaco/servicios" class="text-[#FAF8F5]/60 hover:text-[#E9D8A6] transition-colors flex items-center gap-2 group">
              <span class="opacity-0 group-hover:opacity-100 text-[#E9D8A6]/60">➜</span> Catálogo de Servicios
            </a>
          </li>
          <li>
            <a href="/canaco/eventos" class="text-[#FAF8F5]/60 hover:text-[#E9D8A6] transition-colors flex items-center gap-2 group">
              <span class="opacity-0 group-hover:opacity-100 text-[#E9D8A6]/60">➜</span> Eventos y Patrocinios
            </a>
          </li>
          <li>
            <a href="/canaco/contenido" class="text-[#FAF8F5]/60 hover:text-[#E9D8A6] transition-colors flex items-center gap-2 group">
              <span class="opacity-0 group-hover:opacity-100 text-[#E9D8A6]/60">➜</span> Contenido y Afiliación
            </a>
          </li>
          <li>
            <a href="https://ledger.arksystems.site/?brand=canaco" target="_blank" rel="noopener noreferrer" class="text-[#FAF8F5]/60 hover:text-[#E9D8A6] transition-colors flex items-center gap-2 group">
              <span class="opacity-0 group-hover:opacity-100 text-[#E9D8A6]/60">➜</span> Ventanilla de Afiliación
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Contacto -->
      <div>
        <div class="flex items-center gap-2 mb-6">
          <svg class="h-4 w-4 text-[#FAF8F5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <h4 class="text-xs font-bold uppercase tracking-widest text-[#FAF8F5] font-mono">
            /Contacto
          </h4>
        </div>
        
        <div class="space-y-4 font-canaco text-sm text-[#FAF8F5]/60">
          <div class="flex items-start gap-3">
            <svg class="h-4 w-4 text-[#E9D8A6] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <div class="text-[#FAF8F5] text-xs font-bold font-canaco">Dirección de Atención a Socios</div>
              <div class="text-[10px] text-[#FAF8F5]/30">Mérida, Yucatán</div>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 text-[#E9D8A6]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="https://wa.me/529999428850" target="_blank" rel="noopener noreferrer" class="hover:text-[#E9D8A6] transition-colors">
              +52 999 942 8850
            </a>
          </div>

          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 text-[#E9D8A6]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:atencionasocios@canacomerida.com" class="hover:text-[#E9D8A6] transition-colors">
              atencionasocios@canacomerida.com
            </a>
          </div>

          <div class="pt-4 flex flex-col gap-3 border-t border-[#FAF8F5]/10">
            <a
              href="https://ledger.arksystems.site/?brand=canaco"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-[#FAF8F5]/60 hover:text-[#E9D8A6] transition-colors group"
            >
              <svg class="h-4 w-4 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span>Ventanilla de Afiliación</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna 4: Redes y Alianza -->
      <div>
        <div class="flex items-center gap-2 mb-6">
          <svg class="h-4 w-4 text-[#FAF8F5]/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <h4 class="text-xs font-bold uppercase tracking-widest text-[#FAF8F5] font-mono">
            /Alianzas
          </h4>
        </div>
        
        <div class="space-y-4 font-canaco text-sm text-[#FAF8F5]/60">
          <div class="flex items-center gap-3">
            <svg class="h-4 w-4 text-[#E9D8A6] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
            <div class="text-[#FAF8F5] text-xs font-bold font-canaco">CANACO Nacional</div>
            <div class="text-[10px] text-[#FAF8F5]/30">Cámara Nacional de Comercio</div>
          </div>
          
          <div class="pt-4 flex flex-col gap-3 border-t border-[#FAF8F5]/10">
            <a
              href="https://wa.me/529999428850"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-[#FAF8F5]/60 hover:text-[#E9D8A6] transition-colors group"
            >
              <svg class="h-4 w-4 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span>WhatsApp CANACO</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Sistema (Copyright & Hecho por) -->
    <div class="mt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="font-mono text-[10px] text-[#FAF8F5]/30 uppercase tracking-widest">
        <span class="text-[#E9D8A6]">root@canaco:~$</span> ./camara_servitur_merida
      </div>
      <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4 font-mono text-[10px] text-[#FAF8F5]/40 text-center md:text-right">
        <span>© {new Date().getFullYear()} CANACO SERVYTUR Mérida</span>
        <span class="hidden md:inline text-[#FAF8F5]/20">|</span>
        <span>
          Hecho con ❤️ por <a href="https://arksystems.site/" target="_blank" rel="noopener noreferrer" class="text-[#FD5C0D] hover:text-[#E9D8A6] transition-colors font-bold">Ark Systems</a>
        </span>
      </div>
    </div>
  </div>
</footer>
