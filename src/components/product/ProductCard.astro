---
// src/components/product/ProductCard.astro
import type { Product } from '@/types/product';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="group bg-white rounded-[20px] border border-[#7E1D0F]/10 overflow-hidden hover:shadow-[0_16px_40px_rgba(126,29,15,0.12)] transition-all duration-300">
  <!-- Imagen -->
  <div class="relative h-[200px] overflow-hidden bg-[#FFF1E6]">
    <img 
      src={product.image} 
      alt={product.name}
      class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-700"
      loading="lazy"
    />
    
    <!-- Badges -->
    <div class="absolute top-3 left-3 flex gap-2">
      {product.badge && (
        <span class="px-2.5 py-1 rounded-full bg-[#7E1D0F] text-white text-[10px] font-black tracking-widest shadow-sm">
          {product.badge}
        </span>
      )}
      <span class="px-2.5 py-1 rounded-full bg-white/90 backdrop-blur text-[10px] font-bold border border-black/5 text-[#2B0E0A]">
        Quedan {product.stock}
      </span>
    </div>
    
    <!-- Precio flotante -->
    <div class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-[#FF8800] text-[#2B0E0A] text-xs font-black shadow-sm">
      ${product.price} • {product.weight}
    </div>
  </div>
  
  <!-- Contenido -->
  <div class="p-4">
    <div class="flex items-start justify-between gap-3">
      <div>
        <div class="font-display font-black text-[16px] leading-tight text-[#2B0E0A]">{product.name}</div>
        <div class="text-xs text-[#7E1D0F]/60 font-semibold mt-0.5 font-body">
          {product.weight.toUpperCase()} • {product.desc}
        </div>
      </div>
    </div>
    
    <!-- Botón Agregar -->
    <div class="mt-4 flex items-center gap-2">
      <button 
        data-product-id={product.id}
        class="add-to-cart flex-1 h-10 rounded-full bg-[#2B0E0A] text-white font-bold text-sm hover:bg-black active:scale-[0.98] transition flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Agregar
      </button>
      <div class="h-10 px-3 rounded-full bg-[#FFF1E6] border border-[#FF8800]/20 text-[#7E1D0F] font-black text-sm grid place-items-center">
        ${product.price}
      </div>
    </div>
  </div>
</div>

<script>
  import { useCartStore } from '@/stores/cart';
  
  // Adjuntar evento a todos los botones de esta tarjeta
  document.querySelectorAll('.add-to-cart').forEach((button) => {
    button.addEventListener('click', (e) => {
      const productId = (e.currentTarget as HTMLElement).dataset.productId;
      if (productId) {
        useCartStore.getState().addItem(productId, 1);
        
        // Feedback visual rápido en el botón
        const originalText = (e.currentTarget as HTMLElement).innerHTML;
        (e.currentTarget as HTMLElement).innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Agregado
        `;
        (e.currentTarget as HTMLElement).classList.add('bg-emerald-600');
        
        setTimeout(() => {
          (e.currentTarget as HTMLElement).innerHTML = originalText;
          (e.currentTarget as HTMLElement).classList.remove('bg-emerald-600');
        }, 1500);
      }
    });
  });
</script>