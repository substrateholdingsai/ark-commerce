---
interface Offer {
  id: string;
  name: string;
  weight: string;
  price: number;
  desc: string;
  badge?: string;
  stock: number;
}

interface Props {
  product: Offer;
}

const { product } = Astro.props;
const message = `Hola CANACO SERVYTUR Mérida. Me interesa solicitar información sobre: ${product.name} (${product.weight}) por $${product.price.toLocaleString('es-MX')} MXN.`;
const whatsappUrl = `https://wa.me/529999428850?text=${encodeURIComponent(message)}`;
---

<article class="group overflow-hidden rounded-2xl border border-canaco-accent/10 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
  <div class="relative flex h-44 items-end overflow-hidden bg-gradient-to-br from-canaco-accent to-canaco-accent-dk p-5 text-canaco-primary sm:h-52">
    <div aria-hidden="true" class="absolute -right-8 -top-12 size-48 rounded-full border border-canaco-primary/15"></div>
    <div aria-hidden="true" class="absolute -right-2 -top-6 size-36 rounded-full border border-canaco-primary/15"></div>
    <div class="relative z-10 flex w-full items-end justify-between gap-3">
      <div>
        {product.badge && <span class="mb-2 inline-flex rounded-full border border-canaco-primary/20 bg-canaco-primary/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em]">{product.badge}</span>}
        <p class="font-canaco text-sm font-semibold text-canaco-primary/75">Expo Feria del Comercio 2026</p>
      </div>
      <span class="shrink-0 rounded-full bg-canaco-primary px-3 py-1.5 text-xs font-black text-canaco-accent">${product.price.toLocaleString('es-MX')} MXN</span>
    </div>
  </div>

  <div class="p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-canaco text-xl font-black leading-tight text-canaco-accent">{product.name}</h3>
      <span class="shrink-0 rounded-full bg-canaco-accent/5 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-canaco-accent/70">{product.weight}</span>
    </div>
    <p class="mt-2 min-h-12 text-sm leading-relaxed text-canaco-accent/70">{product.desc}</p>
    <p class="mt-3 text-xs font-semibold text-canaco-accent/55">{product.stock} espacios disponibles</p>
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex min-h-11 w-full items-center justify-center rounded-full bg-canaco-accent px-5 py-3 text-sm font-bold text-white transition hover:bg-canaco-accent-dk focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-canaco-accent">
      Solicitar información
    </a>
  </div>
</article>
