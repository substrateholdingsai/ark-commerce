---
// src/pages/contagram.astro — Huésped Oficial: Contagram (Despacho de Contabilidad)
// Design System: Isfahan Ledger v1.0
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Contagram — Despacho de Contabilidad · Isfahan Ledger</title>
  <meta name="description" content="Contagram no vende miedo fiscal. Entrega certeza matemática: estados financieros, auditoría EFOS y cumplimiento 32-D construidos con rigor.">
  <link rel="icon" type="image/svg+xml" href="/images/contagram/favicon.svg">
  <link rel="manifest" href="/manifest.json?tenant=contagram">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Contagram">
  <meta name="theme-color" content="#071A30">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    :root {
      --lapis-950: #040F1D;
      --lapis-900: #071A30;
      --lapis-800: #0C2440;
      --lapis-700: #143353;
      --lapis-600: #1F476F;
      --lapis-500: #35608A;
      --lapis-300: #8FAAC6;
      --lapis-100: #DCE6F2;
      --gold-500:  #C9A227;
      --gold-400:  #D4AF37;
      --gold-300:  #E3C274;
      --gold-200:  #EED9A0;
      --gold-700:  #7E6114;
      --chalk-50:  #FBF9F4;
    }

    * { -webkit-font-smoothing: antialiased; box-sizing: border-box; }

    body {
      margin: 0;
      background-color: var(--lapis-950);
      background-image: 
        radial-gradient(ellipse 90% 60% at 50% 0%, rgba(20, 51, 83, 0.45), transparent 75%),
        url("/images/contagram/girih-seamless.svg");
      background-size: auto, 480px 480px;
      color: var(--chalk-50);
      font-family: 'IBM Plex Sans', sans-serif;
      min-height: 100vh;
    }

    .font-display { font-family: 'Cormorant Garamond', Georgia, serif; }
    .font-mono { font-family: 'IBM Plex Mono', monospace; }

    .cifra {
      font-family: 'IBM Plex Mono', monospace;
      font-variant-numeric: tabular-nums lining-nums;
      font-feature-settings: "tnum" 1, "lnum" 1;
      text-align: right;
    }

    .tile-surface {
      background: linear-gradient(180deg, rgba(12, 36, 64, 0.85) 0%, rgba(7, 26, 48, 0.95) 100%);
      border: 1px solid var(--lapis-700);
      backdrop-filter: blur(12px);
      position: relative;
      transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .tile-surface:hover {
      border-color: rgba(201, 162, 39, 0.5);
      transform: translateY(-2px);
    }
    .tile-surface.selected {
      background: linear-gradient(180deg, rgba(20, 51, 83, 0.95) 0%, rgba(12, 36, 64, 0.98) 100%);
      border: 1px solid var(--gold-400);
      box-shadow: 0 0 0 1px var(--gold-400), 0 12px 32px rgba(4, 15, 29, 0.8), inset 0 0 24px rgba(201, 162, 39, 0.08);
    }

    .btn-gold {
      background: var(--gold-500);
      color: var(--lapis-950);
      font-weight: 600;
      border: 1px solid var(--gold-300);
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 4px 16px rgba(201, 162, 39, 0.25);
    }
    .btn-gold:hover {
      background: var(--gold-400);
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(201, 162, 39, 0.4);
    }

    .ledger-sheet {
      background: var(--lapis-900);
      border: 1px solid var(--lapis-700);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(227, 194, 116, 0.2);
      position: relative;
    }
    .ledger-sheet::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--gold-500), transparent);
    }

    .khatam-corner {
      position: absolute;
      width: 12px;
      height: 12px;
      border-color: var(--gold-500);
      opacity: 0.5;
    }
    .khatam-tl { top: 6px; left: 6px; border-top: 1px solid; border-left: 1px solid; }
    .khatam-tr { top: 6px; right: 6px; border-top: 1px solid; border-right: 1px solid; }
    .khatam-bl { bottom: 6px; left: 6px; border-bottom: 1px solid; border-left: 1px solid; }
    .khatam-br { bottom: 6px; right: 6px; border-bottom: 1px solid; border-right: 1px solid; }

    .badge-tile {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.12em;
      padding: 3px 8px;
      border-radius: 2px;
      border: 1px solid;
    }
  </style>
</head>

<body class="selection:bg-[#C9A227] selection:text-[#040F1D]">

  <!-- HEADER SUPERIOR -->
  <header class="border-b border-[#143353] bg-[#071A30]/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <img src="/images/contagram/favicon.svg" alt="Sello Khatam" class="w-10 h-10 shadow-lg">
        <div class="border-l border-[#143353] pl-4">
          <div class="font-display text-2xl font-medium tracking-[0.14em] text-[#E3C274]">CONTAGRAM</div>
          <div class="font-sans text-[10px] tracking-[0.24em] text-[#8FAAC6] uppercase">Despacho de Contabilidad</div>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <div class="hidden md:flex flex-col text-right">
          <span class="text-[11px] font-mono text-[#8FAAC6]">ATENCIÓN FISCAL INMEDIATA</span>
          <span class="text-xs font-mono font-medium text-[#E3C274]">+52 56 5706 2511</span>
        </div>
        <a href="#propuesta" class="btn-gold px-5 py-2.5 rounded text-xs tracking-wider uppercase font-mono flex items-center gap-2">
          <span>Cotizador</span>
          <span class="opacity-70">↓</span>
        </a>
      </div>
    </div>
  </header>

  <!-- HERO PRINCIPAL: CERTIDUMBRE EN EQUILIBRIO -->
  <main class="max-w-7xl mx-auto px-6 pt-14 pb-20">
    <section class="grid lg:grid-cols-12 gap-12 items-start">
      
      <!-- Columna Izquierda: Manifiesto -->
      <div class="lg:col-span-7 pt-4">
        <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded border border-[#143353] bg-[#0C2440]/60 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C9A227]"></span>
          <span class="text-[11px] font-mono tracking-[0.2em] text-[#DCE6F2] uppercase">
            Design System · Isfahan Ledger v1.0
          </span>
        </div>

        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-light text-[#FBF9F4] leading-[0.98] tracking-tight">
          Certidumbre fiscal,<br>
          <span class="italic text-[#E3C274] font-normal">en riguroso equilibrio.</span>
        </h1>

        <div class="w-24 h-0.5 bg-[#C9A227] my-8 opacity-80"></div>

        <p class="text-[#DCE6F2] text-lg leading-relaxed font-light max-w-2xl">
          Contagram no vende miedo fiscal. Entrega <strong class="text-[#FBF9F4] font-medium">certeza matemática</strong>: el estado financiero como una pieza bien construida, donde cada cifra está en su lugar porque el sistema la obliga a estarlo.
        </p>

        <blockquote class="my-6 border-l-2 border-[#C9A227] pl-4 text-sm italic text-[#8FAAC6] font-display text-base">
          "Un libro mayor es un mosaico: si una tesela falla, se ve en todo el muro."
        </blockquote>

        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-[#143353]">
          <div class="p-3 bg-[#071A30]/80 border border-[#143353] rounded">
            <div class="text-[10px] font-mono text-[#C9A227] uppercase tracking-wider mb-1">AUDITORÍA EFOS</div>
            <div class="text-xs text-[#DCE6F2] font-light">Blindaje 69-B del CFF en tiempo real.</div>
          </div>
          <div class="p-3 bg-[#071A30]/80 border border-[#143353] rounded">
            <div class="text-[10px] font-mono text-[#2E7D6F] uppercase tracking-wider mb-1">OPINIÓN 32-D</div>
            <div class="text-xs text-[#DCE6F2] font-light">Cumplimiento positivo continuo ante SAT.</div>
          </div>
          <div class="p-3 bg-[#071A30]/80 border border-[#143353] rounded">
            <div class="text-[10px] font-mono text-[#D98324] uppercase tracking-wider mb-1">CFDI 4.0</div>
            <div class="text-xs text-[#DCE6F2] font-light">Conciliación estricta banco vs timbrado.</div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Libro Mayor Interactivo -->
      <div class="lg:col-span-5" id="propuesta">
        <div class="ledger-sheet rounded-lg p-6 lg:sticky lg:top-28">
          <div class="khatam-corner khatam-tl"></div>
          <div class="khatam-corner khatam-tr"></div>
          <div class="khatam-corner khatam-bl"></div>
          <div class="khatam-corner khatam-br"></div>

          <div class="flex justify-between items-start pb-4 border-b border-[#143353]">
            <div>
              <div class="text-[11px] font-mono tracking-[0.2em] text-[#C9A227] uppercase">PÓLIZA DE APERTURA DE SERVICIOS</div>
              <div class="text-xs font-mono text-[#8FAAC6] mt-0.5">FOLIO: CTG-2026-0814</div>
            </div>
            <span class="badge-tile border-[#2E7D6F] text-[#2E7D6F] bg-[#2E7D6F]/10">CONCILIADO</span>
          </div>

          <div class="py-6 border-b border-[#143353]/80">
            <div class="flex justify-between items-baseline">
              <span class="text-xs font-mono text-[#8FAAC6] uppercase tracking-wider">Honorarios Netos</span>
              <span class="text-[11px] font-mono text-[#C9A227]">MXN · TASA 16% IVA</span>
            </div>
            <div class="text-right mt-2">
              <span class="cifra text-5xl md:text-6xl font-medium text-[#FBF9F4]" id="totalNetoDisplay">$0</span>
            </div>
            <div class="flex justify-between items-center mt-2 text-[11px] font-mono text-[#8FAAC6]">
              <span id="serviciosCount">0 SERVICIOS INTEGRADOS</span>
              <span>BALANCE CUADRADO</span>
            </div>
          </div>

          <div class="py-4 space-y-2.5 min-h-[140px]" id="asientoList">
            <div class="text-center py-8 text-xs font-mono text-[#8FAAC6]/60">
              [ Selecciona del portafolio inferior para integrar teselas a la póliza ]
            </div>
          </div>

          <div class="pt-4 border-t border-[#143353] space-y-2 text-xs font-mono">
            <div class="flex justify-between text-[#8FAAC6]">
              <span>BASE IMPOSITIVA:</span>
              <span class="cifra text-[#DCE6F2]" id="baseImpositivaDisplay">$0</span>
            </div>
            <div class="flex justify-between text-[#8FAAC6]">
              <span>I.V.A. TRASLADADO (16%):</span>
              <span class="cifra text-[#DCE6F2]" id="ivaDisplay">$0</span>
            </div>
            <div class="flex justify-between text-[#E3C274] font-medium pt-2 border-t border-[#143353]/60">
              <span>SUMAS IGUALES:</span>
              <span class="cifra" id="sumasIgualesDisplay">$0</span>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-[#143353] space-y-3">
            <div>
              <label class="block text-[10px] font-mono text-[#8FAAC6] uppercase tracking-wider mb-1">RFC / Razón Social</label>
              <input type="text" id="rfcInput" placeholder="Ej: CTG240101XYZ" class="w-full bg-[#040F1D] border border-[#143353] rounded px-3 py-2 text-xs text-[#FBF9F4] font-mono focus:border-[#C9A227] focus:outline-none">
            </div>
            <div>
              <label class="block text-[10px] font-mono text-[#8FAAC6] uppercase tracking-wider mb-1">Representante o Contacto</label>
              <input type="text" id="nombreInput" placeholder="Nombre completo" class="w-full bg-[#040F1D] border border-[#143353] rounded px-3 py-2 text-xs text-[#FBF9F4] font-mono focus:border-[#C9A227] focus:outline-none">
            </div>
          </div>

          <div class="mt-6">
            <button onclick="formalizarWhatsApp()" id="formalizarBtn" disabled class="btn-gold w-full py-3.5 rounded text-xs tracking-[0.16em] uppercase font-mono disabled:opacity-40 disabled:cursor-not-allowed">
              Formalizar Propuesta vía WhatsApp
            </button>
            <div class="text-center mt-3 text-[10px] font-mono text-[#8FAAC6]">
              Transferencia SPEI: <strong class="text-[#DCE6F2]">Banco Azteca</strong> · CLABE: <span class="text-[#E3C274]">1271 8000 1844 7214 31</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: EL MOSAICO DE SERVICIOS -->
    <section class="mt-24 pt-12 border-t border-[#143353]">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <div class="text-[11px] font-mono tracking-[0.2em] text-[#C9A227] uppercase">Catálogo Estructurado</div>
          <h2 class="font-display text-4xl font-light text-[#FBF9F4] mt-1">Portafolio de Pólizas y Dictámenes</h2>
        </div>
        <p class="text-xs font-mono text-[#8FAAC6] mt-2 md:mt-0">
          Haz clic en cada servicio para incorporarlo a tu libro mayor.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6" id="servicesGrid">
        <!-- Inyectado dinámicamente -->
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-[#143353] bg-[#040F1D] py-12 mt-16 text-xs font-mono text-[#8FAAC6]">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-3">
        <img src="/images/contagram/favicon.svg" alt="Sello" class="w-6 h-6 opacity-80">
        <span>CONTAGRAM © 2026 · Despacho de Contabilidad & Auditoría</span>
      </div>
      <div class="text-center md:text-right">
        <span class="text-[#E3C274]">"La certeza es ornamental. El orden se ve."</span>
      </div>
    </div>
  </footer>

  <script is:inline>
    const SERVICIOS = [
      {
        id: "cont-gen",
        nombre: "Contabilidad General y Balanza Mensual",
        periodo: "Honorario Mensual",
        alcance: "Hasta 60 pólizas analíticas",
        base: 2800,
        badge: "BASE · RECURRENTE",
        badgeColor: "border-[#2E7D6F] text-[#2E7D6F]",
        desc: "Registro analítico de operaciones, conciliación bancaria exhaustiva, balanza de comprobación mensual y emisión de estados financieros para toma de decisiones.",
        entregables: ["Balanza de Comprobación", "Estado de Resultados", "Conciliación Bancaria"]
      },
      {
        id: "cumpl-fisc",
        nombre: "Cumplimiento Tributario y Declaraciones",
        periodo: "Por Ejercicio / Mensual",
        alcance: "ISR, IVA, Retenciones y DIOT",
        base: 3500,
        badge: "OBLIGATORIO SAT",
        badgeColor: "border-[#C9A227] text-[#C9A227]",
        desc: "Cálculo matemático exacto de contribuciones federales, presentación formal ante el portal del SAT y atención inmediata a requerimientos para asegurar Opinión 32-D Positiva.",
        entregables: ["Acuse de Aceptación SAT", "Línea de Captura para Pago", "Opinión 32-D"]
      },
      {
        id: "nomina-imss",
        nombre: "Gestión de Nómina y Seguridad Social",
        periodo: "Emisión Quincenal",
        alcance: "Hasta 10 colaboradores",
        base: 1950,
        badge: "OPERATIVO",
        badgeColor: "border-[#35608A] text-[#8FAAC6]",
        desc: "Dispersión, timbrado de recibos CFDI 4.0 de nómina, cálculo de liquidaciones, finiquitos y control riguroso de movimientos ante IDSE (IMSS) y SUA/INFONAVIT.",
        entregables: ["Recibos XML/PDF Timbrados", "Cédula de Determinación SUA", "Emisión Mensual IMSS"]
      },
      {
        id: "auditoria-diag",
        nombre: "Auditoría Financiera y Blindaje EFOS",
        periodo: "Por Dictamen / Proyecto",
        alcance: "Auditoría integral profunda",
        base: 8500,
        badge: "ALTO TICKET · BLINDAJE",
        badgeColor: "border-[#D98324] text-[#D98324]",
        desc: "Inspección forense de CFDI emitidos vs recibidos, prevención de discrepancia fiscal, validación automática de proveedores contra listas negras del Art. 69-B del CFF.",
        entregables: ["Dictamen de Riesgos Fiscales", "Matriz de Proveedores Críticos", "Plan de Corrección"]
      }
    ];

    let seleccionados = new Set(["cont-gen"]);

    function renderServicios() {
      const container = document.getElementById("servicesGrid");
      if (!container) return;
      container.innerHTML = SERVICIOS.map(s => {
        const isSelected = seleccionados.has(s.id);
        return `
          <div onclick="toggleServicio('${s.id}')" class="tile-surface ${isSelected ? 'selected' : ''} rounded-lg p-6 cursor-pointer">
            <div class="flex justify-between items-start mb-3">
              <span class="badge-tile ${s.badgeColor} bg-[#040F1D]/60">${s.badge}</span>
              <div class="cifra text-2xl font-medium ${isSelected ? 'text-[#E3C274]' : 'text-[#FBF9F4]'}">
                $${s.base.toLocaleString('es-MX')} <span class="text-xs text-[#8FAAC6] font-mono">MXN</span>
              </div>
            </div>

            <h3 class="font-display text-2xl text-[#FBF9F4] mb-1">${s.nombre}</h3>
            <div class="text-xs font-mono text-[#8FAAC6] mb-4">${s.periodo} · ${s.alcance}</div>

            <p class="text-sm text-[#DCE6F2] font-light leading-relaxed mb-5">${s.desc}</p>

            <div class="pt-4 border-t border-[#143353] flex items-center justify-between">
              <div class="text-[11px] font-mono text-[#8FAAC6]">
                ${s.entregables.join(" • ")}
              </div>
              <button class="text-xs font-mono uppercase px-3 py-1 rounded border ${isSelected ? 'border-[#C9A227] text-[#C9A227] bg-[#C9A227]/10' : 'border-[#143353] text-[#8FAAC6]'}">
                ${isSelected ? '✓ Integrado' : '+ Seleccionar'}
              </button>
            </div>
          </div>
        `;
      }).join("");
    }

    window.toggleServicio = function(id) {
      if (seleccionados.has(id)) {
        seleccionados.delete(id);
      } else {
        seleccionados.add(id);
      }
      actualizarLibroMayor();
      renderServicios();
    };

    function actualizarLibroMayor() {
      const items = SERVICIOS.filter(s => seleccionados.has(s.id));
      const base = items.reduce((acc, s) => acc + s.base, 0);
      const iva = base * 0.16;
      const neto = base + iva;

      document.getElementById("baseImpositivaDisplay").textContent = "$" + base.toLocaleString('es-MX');
      document.getElementById("ivaDisplay").textContent = "$" + iva.toLocaleString('es-MX');
      document.getElementById("sumasIgualesDisplay").textContent = "$" + neto.toLocaleString('es-MX');
      document.getElementById("totalNetoDisplay").textContent = "$" + neto.toLocaleString('es-MX');
      document.getElementById("serviciosCount").textContent = `${items.length} SERVICIO${items.length === 1 ? '' : 'S'} INTEGRADO${items.length === 1 ? '' : 'S'}`;

      document.getElementById("formalizarBtn").disabled = items.length === 0;

      const asientoContainer = document.getElementById("asientoList");
      if (items.length === 0) {
        asientoContainer.innerHTML = `
          <div class="text-center py-8 text-xs font-mono text-[#8FAAC6]/60">
            [ Selecciona al menos un servicio del mosaico para generar la póliza ]
          </div>
        `;
      } else {
        asientoContainer.innerHTML = items.map(it => `
          <div class="flex justify-between items-center text-xs font-mono py-1 border-b border-[#143353]/40">
            <div class="text-[#DCE6F2] truncate pr-3">
              <span class="text-[#C9A227] mr-1.5">•</span>${it.nombre}
            </div>
            <div class="cifra text-[#E3C274] font-medium whitespace-nowrap">
              $${it.base.toLocaleString('es-MX')}
            </div>
          </div>
        `).join("");
      }
    }

    window.formalizarWhatsApp = function() {
      const items = SERVICIOS.filter(s => seleccionados.has(s.id));
      if (items.length === 0) return;

      const base = items.reduce((acc, s) => acc + s.base, 0);
      const iva = base * 0.16;
      const neto = base + iva;

      const rfc = document.getElementById("rfcInput").value.trim() || "(Por definir)";
      const contacto = document.getElementById("nombreInput").value.trim() || "(Por definir)";

      const mensaje = 
`🏛️ *CONTAGRAM — Despacho de Contabilidad*
_Solicitud Formal de Propuesta de Servicios Fiscales_

*PÓLIZA DE SERVICIOS INTEGRADOS:*
${items.map(s => `• *${s.nombre}* (${s.periodo})\n  Base: $${s.base.toLocaleString('es-MX')} MXN`).join("\n")}

--------------------------------------
*Base Impositiva:* $${base.toLocaleString('es-MX')} MXN
*I.V.A. (16%):* $${iva.toLocaleString('es-MX')} MXN
*TOTAL NETO ESTIMADO:* $${neto.toLocaleString('es-MX')} MXN
--------------------------------------
*RFC / Razón Social:* ${rfc}
*Representante:* ${contacto}
*Banco Destino para Liquidación:* Banco Azteca
*CLABE Interbancaria:* 1271 8000 1844 7214 31

_Solicito asignación de un contador certificado para formalización de contrato y alta de póliza fiscal._`;

      const url = `https://wa.me/525657062511?text=${encodeURIComponent(mensaje)}`;
      window.open(url, "_blank");
    };

    renderServicios();
    actualizarLibroMayor();
  </script>
</body>
</html>
