---
// src/pages/mayoreo.astro
import Layout from '@/layouts/Layout.astro';

const BENEFITS = [
  {
    id: "supply",
    icon: `<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>`,
    title: "Abastecimiento Constante",
    desc: "Garantizamos disponibilidad y frescura para tu restaurante, hotel o negocio, con producción programada según tu demanda."
  },
  {
    id: "quality",
    icon: `<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>`,
    title: "Calidad Premium Certificada",
    desc: "Mismos estándares artesanales que nos hicieron famosos, pero con la consistencia y el volumen que tu operación requiere."
  },
  {
    id: "delivery",
    icon: `<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>`,
    title: "Logística Puntual",
    desc: "Entregas programadas en Mérida y alrededores. Respetamos tus horarios de operación para que nunca te falte producto."
  }
];
---

<Layout 
  title="Mayoreo" 
  description="Abastecimiento de carnes ahumadas artesanales para restaurantes, hoteles y negocios en Mérida. Calidad y logística garantizada."
>
  <!-- ══════════ HERO ══════════ -->
  <section class="relative flex min-h-[55vh] items-center justify-center overflow-hidden bg-[#2A1A0A] px-6 py-16 text-center">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-[#F59E0B]/10 via-transparent to-[#2A1A0A] pointer-events-none" />

    <!-- Humo + brasas -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="smoke left-[15%] top-[10%] h-56 w-56" />
      <div class="smoke right-[12%] top-[18%] h-72 w-72" style="animation-delay: 3s;" />
      <span class="ember left-[14%] top-[26%]" />
      <span class="ember left-[30%] top-[16%]" style="animation-delay: 1.2s;" />
      <span class="ember left-[52%] top-[12%]" style="animation-delay: 2.4s;" />
      <span class="ember left-[70%] top-[20%]" style="animation-delay: 0.8s;" />
      <span class="ember left-[86%] top-[28%]" style="animation-delay: 1.8s;" />
    </div>

    <div class="relative z-10 mx-auto max-w-4xl space-y-6 animate-fade-up">
      <p class="font-display text-sm uppercase tracking-[0.3em] text-[#FDE047]">
        Soluciones para tu Negocio
      </p>

      <h1 class="font-script text-5xl font-bold italic leading-[0.95] text-[#FFFCF5] md:text-7xl">
        Mayoreo Temozonia
      </h1>

      <p class="mx-auto max-w-3xl font-body text-lg leading-relaxed text-[#FFFCF5]/90 md:text-xl">
        Lleva el sabor artesanal que tus clientes aman, con la consistencia, volumen y logística que tu operación necesita.
      </p>

      <div class="gold-divider mx-auto w-40 pt-4">
        <span aria-hidden="true" class="text-[#D4AF37]">◆</span>
      </div>
    </div>
  </section>

  <!-- ══════════ BENEFICIOS ══════════ -->
  <section class="bg-[#F9F3E9] px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-12 text-center font-display text-4xl font-bold text-[#2A1A0A] md:text-5xl">
        ¿Por qué elegirnos como tu proveedor?
      </h2>

      <div class="grid gap-8 md:grid-cols-3">
        {BENEFITS.map((item) => (
          <div class="rounded-2xl border-2 border-[#D4AF37]/30 bg-[#FFFCF5] p-8 text-center transition-transform hover:-translate-y-2 hover:shadow-[0_8px_24px_rgba(212,175,55,0.25)]">
            <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full border-2 border-[#D4AF37] bg-[#2A1A0A] text-[#D4AF37]">
              {item.icon}
            </div>
            <h3 class="mb-3 font-display text-lg font-bold text-[#2A1A0A]">
              {item.title}
            </h3>
            <p class="font-body text-sm leading-relaxed text-[#4A3A2A]">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ FORMULARIO ══════════ -->
  <section class="bg-[#FFF9F3] px-6 py-16 md:py-20">
    <div class="mx-auto max-w-3xl">
      <div class="receipt-gold p-8 md:p-12">
        <div class="mb-8 text-center">
          <h2 class="font-script text-4xl font-bold italic text-[#8B1E1E] md:text-5xl">
            Solicita tu Cotización
          </h2>
          <p class="mt-3 font-body text-base text-[#4A3A2A]">
            Cuéntanos sobre tu negocio y te enviaremos una propuesta a medida en menos de 24 horas.
          </p>
        </div>

        <form id="wholesale-form" class="space-y-5">
          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <label for="biz-name" class="mb-1 block text-xs font-bold uppercase tracking-widest text-[#4A3A2A]">
                Nombre del Negocio
              </label>
              <input 
                id="biz-name" 
                name="bizName" 
                type="text" 
                required
                placeholder="Ej. Restaurante El Fogón"
                class="w-full rounded-xl border-2 border-[#7E1D0F]/10 bg-[#FFF9F3] px-4 py-2.5 font-body text-sm text-[#2A1A0A] placeholder:text-[#4A3A2A]/40 focus:border-[#FD5C0D] focus:outline-none"
              />
            </div>
            <div>
              <label for="contact-name" class="mb-1 block text-xs font-bold uppercase tracking-widest text-[#4A3A2A]">
                Nombre del Contacto
              </label>
              <input 
                id="contact-name" 
                name="contactName" 
                type="text" 
                required
                placeholder="Ej. Juan Pérez"
                class="w-full rounded-xl border-2 border-[#7E1D0F]/10 bg-[#FFF9F3] px-4 py-2.5 font-body text-sm text-[#2A1A0A] placeholder:text-[#4A3A2A]/40 focus:border-[#FD5C0D] focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="phone" class="mb-1 block text-xs font-bold uppercase tracking-widest text-[#4A3A2A]">
              Teléfono / WhatsApp
            </label>
            <input 
              id="phone" 
              name="phone" 
              type="tel" 
              required
              placeholder="999 123 4567"
              class="w-full rounded-xl border-2 border-[#7E1D0F]/10 bg-[#FFF9F3] px-4 py-2.5 font-body text-sm text-[#2A1A0A] placeholder:text-[#4A3A2A]/40 focus:border-[#FD5C0D] focus:outline-none"
            />
          </div>

          <div>
            <label for="volume" class="mb-1 block text-xs font-bold uppercase tracking-widest text-[#4A3A2A]">
              Volumen Estimado Mensual
            </label>
            <select 
              id="volume" 
              name="volume" 
              required
              class="w-full rounded-xl border-2 border-[#7E1D0F]/10 bg-[#FFF9F3] px-4 py-2.5 font-body text-sm text-[#2A1A0A] focus:border-[#FD5C0D] focus:outline-none appearance-none"
            >
              <option value="" disabled selected>Selecciona una opción</option>
              <option value="10-20 kg">10 - 20 kg</option>
              <option value="20-50 kg">20 - 50 kg</option>
              <option value="50+ kg">Más de 50 kg</option>
              <option value="Evento único">Evento único / Catering</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-1 block text-xs font-bold uppercase tracking-widest text-[#4A3A2A]">
              Detalles o Productos de Interés
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="4"
              placeholder="Ej. Nos interesa el Pack Parrillero y la Longaniza para los fines de semana..."
              class="w-full resize-none rounded-xl border-2 border-[#7E1D0F]/10 bg-[#FFF9F3] px-4 py-2.5 font-body text-sm text-[#2A1A0A] placeholder:text-[#4A3A2A]/40 focus:border-[#FD5C0D] focus:outline-none"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="btn-heritage mt-4 w-full rounded-full py-4 text-base font-black uppercase tracking-widest transition"
          >
            Enviar Solicitud por WhatsApp
          </button>

          <p class="mt-4 text-center text-xs text-[#4A3A2A]/60">
            Al enviar, se abrirá WhatsApp con los datos de tu solicitud pre-cargados para una atención inmediata.
          </p>
        </form>
      </div>
    </div>
  </section>

  <style>
    /* Animaciones de humo y brasas */
    @keyframes smoke-rise {
      0% { transform: translateY(0) scale(1); opacity: 0.3; }
      50% { opacity: 0.5; }
      100% { transform: translateY(-100px) scale(1.5); opacity: 0; }
    }
    @keyframes ember-float {
      0% { transform: translateY(0) scale(1); opacity: 0.6; }
      50% { transform: translateX(10px) scale(1.2); opacity: 1; }
      100% { transform: translateY(-80px) translateX(-10px) scale(0.8); opacity: 0; }
    }
    .smoke {
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, rgba(245,158,11,0.15), transparent 70%);
      filter: blur(40px);
      animation: smoke-rise 12s ease-in-out infinite;
    }
    .ember {
      position: absolute;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #FD5C0D;
      box-shadow: 0 0 8px #FD5C0D, 0 0 16px #F54B06;
      animation: ember-float 8s ease-in-out infinite;
    }
    .gold-divider {
      background: linear-gradient(90deg, transparent, #D4AF37, transparent);
      height: 1px;
      position: relative;
    }
    .gold-divider span {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #FFF9F3;
      padding: 0 8px;
      font-size: 12px;
    }
  </style>

  <script>
    document.getElementById('wholesale-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target as HTMLFormElement);
      const bizName = formData.get('bizName');
      const contactName = formData.get('contactName');
      const phone = formData.get('phone');
      const volume = formData.get('volume');
      const message = formData.get('message');

      const text = `Hola Temozonia, soy ${contactName} de *${bizName}*.\n\n` +
        `📞 Teléfono: ${phone}\n` +
        `📦 Volumen estimado: ${volume}\n` +
        `💬 Detalles: ${message || 'Me gustaría recibir una cotización general.'}\n\n` +
        `Quedo atento a su respuesta. ¡Gracias!`;

      const whatsappUrl = `https://wa.me/529994918221?text=${encodeURIComponent(text)}`;
      window.open(whatsappUrl, '_blank');
    });
  </script>
</Layout>