---
// src/pages/index.astro — Plataforma Principal: Ark Systems (Landing Express Kit)
import '../styles/globals.css';
import ArkLanding from '../components/ark/ArkLanding';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ark Systems | Landing Express Kit — Vende Landings Que Cobran En 1 HTML</title>
    <meta
      name="description"
      content="Sin WordPress, sin Shopify, sin mensualidades. 1 archivo, deploy en 3 minutos, cobra con Stripe, Mercado Pago y Bitcoin Lightning."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Si la petición viene dirigida a Temozonia por subdominio o parámetro, redirigir a su tienda
      (function() {
        try {
          const params = new URLSearchParams(window.location.search);
          const tenant = params.get('tenant');
          const host = window.location.hostname;
          if (tenant === 'temozonia' || host.startsWith('temozonia.')) {
            window.location.replace('/temozonia' + window.location.search);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[#0A0A0B] text-zinc-100 min-h-screen">
    <ArkLanding client:load />
  </body>
</html>
