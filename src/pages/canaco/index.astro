---
// src/pages/canaco/index.astro — Landing CANACO SERVYTUR Mérida
import CanacoLayout from '../../layouts/CanacoLayout.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import CheckoutCalculator from '../../components/checkout/CheckoutCalculator.astro';

const CANACO_PRODUCTS = [
  {
    id: 'prod_stand_2x2',
    name: 'Stand Estándar 2x2',
    weight: 'Unidad',
    price: 8000,
    desc: 'Expo Feria del Comercio 2026 — Stand estándar 2x2 metros',
    image: '/images/canaco/stand-2x2.jpg',
    badge: 'ESTÁNDAR',
    stock: 99,
  },
  {
    id: 'prod_sponsor_oro',
    name: 'Patrocinio Oro — Desayuno Networking',
    weight: 'Paquete',
    price: 9500,
    desc: '10 min de presentación + Banner en desayuno networking',
    image: '/images/canaco/sponsor-oro.jpg',
    badge: 'PATROCINIO',
    stock: 10,
  },
] as const;
---

<CanacoLayout title="CANACO SERVYTUR Mérida · Stands y Patrocinios Expo Feria 2026" description="Adquiere tu stand o patrocinio para la Expo Feria del Comercio 2026 en Mérida, Yucatán. Conéctate con cientos de comerciantes y empresas del sureste." url="/" image="/images/canaco/stand-2x2.jpg">

  <!-- Hero -->
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden bg-canaco-primary text-canaco-accent px-6 py-14">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_25%,_rgba(26,58,92,0.08),_transparent_60%)]" />
    <div class="relative z-10 mx-auto max-w-5xl text-center animate-fade-up space-y-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-canaco-accent/30 bg-canaco-accent/10 px-5 py-2 font-canaco text-[11px] font-bold uppercase tracking-[0.22em] text-canaco-accent backdrop-blur-sm">
        <svg class="size-3.5 text-canaco-accent" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        EXPO FERIA DEL COMERCIO 2026
      </span>
      <h1 class="font-canaco font-black text-5xl font-bold leading-[1.05] md:text-7xl lg:text-8xl tracking-tight">
        CANACO SERVYTUR<br class="hidden md:block" />Mérida
      </h1>
      <p class="mx-auto max-w-2xl font-canaco text-lg leading-relaxed text-canaco-accent/80 md:text-xl">
        Reserva tu stand o patrocinio para la Expo Feria del Comercio 2026. Conéctate con cientos de comerciantes y empresas de Mérida y el sureste.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
        <a href="https://ledger.arksystems.site/?brand=canaco" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-10 py-5 rounded-full bg-canaco-accent text-canaco-primary font-canaco font-black text-base uppercase tracking-widest shadow-[0_0_30px_rgba(26,58,92,0.4)] hover:bg-canaco-accent-dk transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Solicitar Afiliación (Ventanilla CANACO)
        </a>
        <a href="#productos" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full border-2 border-canaco-accent text-canaco-accent font-canaco font-bold text-base hover:bg-canaco-accent/10 transition">
          Ver Ofertas de Stand
        </a>
        <a href="https://wa.me/529999428850" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-8 py-4 rounded-full border-2 border-canaco-accent text-canaco-accent font-canaco font-bold text-base hover:bg-canaco-accent/10 transition">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          WhatsApp CANACO
        </a>
      </div>
    </div>
  </section>

  <!-- Productos (Stands / Patrocinios) -->
  <section id="productos" class="max-w-[1160px] mx-auto px-4 pt-16 pb-10">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="font-canaco font-black text-[26px] sm:text-[34px] tracking-tight text-canaco-accent">
          Ofertas para tu negocio
        </h2>
        <p class="text-sm mt-1 font-canaco text-canaco-accent/60">
          {CANACO_PRODUCTS.length} opciones · Precios en MXN · Pago por transferencia SPEI o efectivo
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {CANACO_PRODUCTS.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>

  <!-- Checkout Calculator -->
  <CheckoutCalculator />

</CanacoLayout>
