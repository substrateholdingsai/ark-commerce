---
// src/pages/canaco/contenido.astro — Página dinámica de contenido CANACO SERVYTUR Mérida
import CanacoLayout from '../../layouts/CanacoLayout.astro';
import { CANACO_CONTENT } from '../../data/canaco-content';

const { camara, anio, eventos, contacto_general } = CANACO_CONTENT;

// QR de afiliación → WhatsApp de CANACO
const qrText = encodeURIComponent(
  'Quiero afiliarme a CANACO SERVYTUR Mérida — solicitud de membresía'
);
const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://wa.me/529999428850?text=${qrText}`;

const formatMoney = (costo: number, moneda = 'MXN') =>
  new Intl.NumberFormat('es-MX', { style: 'currency', currency: moneda }).format(costo);
---

<CanacoLayout
  title={`${camara} · Contenido y Eventos ${anio}`}
  description="Contenido oficial de CANACO SERVYTUR Mérida: eventos, patrocinios, costos de stands y datos de contacto."
  url="/contenido"
  image="/images/canaco/stand-2x2.jpg"
>

  <!-- Hero -->
  <section class="relative min-h-[55vh] flex items-center justify-center overflow-hidden bg-canaco-primary text-canaco-accent px-6 py-12">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_25%,_rgba(26,58,92,0.08),_transparent_60%)]" />
    <div class="relative z-10 mx-auto max-w-4xl text-center animate-fade-up space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-canaco-accent/30 bg-canaco-accent/10 px-5 py-2 font-canaco text-[11px] font-bold uppercase tracking-[0.22em] text-canaco-accent backdrop-blur-sm">
        {camara} · {anio}
      </span>
      <h1 class="font-canaco font-black text-4xl sm:text-5xl font-bold leading-[1.05] md:text-6xl tracking-tight">
        Contenido y Eventos
      </h1>
      <p class="mx-auto max-w-2xl font-canaco text-lg leading-relaxed text-canaco-accent/80">
        Toda la información de nuestros eventos, niveles de patrocinio, costos de stands y datos de contacto de la Cámara.
      </p>
    </div>
  </section>

  <!-- Eventos -->
  <section id="eventos" class="max-w-[1200px] mx-auto px-4 pt-16 pb-10">
    <div class="mb-12">
      <h2 class="font-canaco font-black text-[30px] sm:text-[40px] tracking-tight text-canaco-accent mb-3">
        Nuestros Eventos
      </h2>
      <p class="font-canaco text-lg text-canaco-accent/60 max-w-2xl">
        Descubre los eventos empresariales de CANACO SERVYTUR Mérida y los beneficios de cada nivel de patrocinio.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {eventos.map((evt) => (
        <article
          class="bg-white border border-canaco-accent/10 rounded-[24px] overflow-hidden hover:border-canaco-accent/40 hover:shadow-[0_20px_40px_rgba(26,58,92,0.08)] transition-all duration-300 flex flex-col"
        >
          <div class="h-48 bg-canaco-primary/40 flex items-center justify-center p-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white text-canaco-accent font-canaco font-bold text-[10px] uppercase tracking-wider shadow-sm">
              {evt.patrocinios ? evt.patrocinios.length : 0} niveles
            </span>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center gap-2 mb-2 text-canaco-accent/50">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span class="font-canaco text-sm font-semibold">{evt.proxima_fecha ?? evt.fecha ?? 'Fecha por confirmar'}</span>
            </div>
            <h3 class="font-canaco font-bold text-[18px] text-canaco-accent mb-3 leading-tight">{evt.nombre}</h3>
            <p class="font-canaco text-sm text-canaco-accent/70 leading-relaxed mb-4 flex-1">{evt.descripcion}</p>

            {evt.alcance && (
              <div class="mb-4 p-3 rounded-lg bg-canaco-accent/5 border border-canaco-accent/10">
                <span class="font-canaco text-xs font-bold uppercase tracking-wider text-canaco-accent/60 block mb-1">Alcance</span>
                <span class="font-canaco text-sm text-canaco-accent">{evt.alcance}</span>
              </div>
            )}
            {evt.formato && (
              <div class="mb-4 p-3 rounded-lg bg-canaco-accent/5 border border-canaco-accent/10">
                <span class="font-canaco text-xs font-bold uppercase tracking-wider text-canaco-accent/60 block mb-1">Formato</span>
                <span class="font-canaco text-sm text-canaco-accent">{evt.formato}</span>
              </div>
            )}
            {evt.lugar && (
              <div class="mb-4 p-3 rounded-lg bg-canaco-accent/5 border border-canaco-accent/10">
                <span class="font-canaco text-xs font-bold uppercase tracking-wider text-canaco-accent/60 block mb-1">Lugar</span>
                <span class="font-canaco text-sm text-canaco-accent">{evt.lugar}</span>
              </div>
            )}
            {evt.expectativa && (
              <div class="mb-4 p-3 rounded-lg bg-canaco-accent/5 border border-canaco-accent/10">
                <span class="font-canaco text-xs font-bold uppercase tracking-wider text-canaco-accent/60 block mb-1">Expectativa</span>
                <span class="font-canaco text-sm text-canaco-accent">{evt.expectativa}</span>
              </div>
            )}

            {evt.actividades && evt.actividades.length > 0 && (
              <div class="mb-4">
                <span class="font-canaco text-xs font-bold uppercase tracking-wider text-canaco-accent/60 block mb-2">Actividades</span>
                <ul class="list-disc list-inside font-canaco text-sm text-canaco-accent/70 space-y-1">
                  {evt.actividades.map((a) => <li>{a}</li>)}
                </ul>
              </div>
            )}

            {evt.patrocinios && evt.patrocinios.length > 0 && (
              <div class="mt-auto pt-4 border-t border-canaco-accent/10">
                <h4 class="font-canaco font-bold text-sm text-canaco-accent mb-3 uppercase tracking-wider text-canaco-accent/70">
                  Patrocinios
                </h4>
                {evt.patrocinios.map((pat) => (
                  <div key={pat.nivel} class="mb-3 p-3 rounded-lg border border-canaco-accent/10 bg-canaco-primary/30">
                    <div class="flex justify-between items-start mb-1">
                      <span class="font-canaco font-bold text-sm text-canaco-accent">{pat.nivel}</span>
                      <span class="font-canaco font-bold text-sm text-canaco-accent">{formatMoney(pat.costo, pat.moneda)}</span>
                    </div>
                    <ul class="list-disc list-inside font-canaco text-xs text-canaco-accent/60 space-y-1">
                      {pat.beneficios.map((b) => <li key={b.texto}>{b.texto}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            )}

            {evt.costos_stands_preventa && evt.costos_stands_preventa.length > 0 && (
              <div class="mt-auto pt-4 border-t border-canaco-accent/10">
                <h4 class="font-canaco font-bold text-sm text-canaco-accent mb-3 uppercase tracking-wider text-canaco-accent/70">
                  Costos de Stands (Preventa)
                </h4>
                <ul class="font-canaco text-sm text-canaco-accent/60 space-y-1">
                  {evt.costos_stands_preventa.map((s) => (
                    <li key={s.tipo} class="flex justify-between">
                      <span>{s.tipo}</span>
                      <span class="font-bold text-canaco-accent">{formatMoney(s.costo, s.moneda)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="max-w-[1200px] mx-auto px-4 pt-16 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      <div>
        <h2 class="font-canaco font-black text-[26px] tracking-tight text-canaco-accent mb-6">
          Contacto General
        </h2>
        <div class="space-y-4">
          <div class="flex items-start gap-4 p-4 rounded-xl border border-canaco-accent/10 bg-white">
            <div class="w-10 h-10 rounded-lg bg-canaco-accent/10 flex items-center justify-center text-canaco-accent font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <span class="font-canaco text-xs font-bold uppercase tracking-wider text-canaco-accent/60 block">{contacto_general.departamento}</span>
              <a href={`mailto:${contacto_general.correo}`} class="font-canaco text-lg font-bold text-canaco-accent hover:underline">{contacto_general.correo}</a>
              <span class="font-canaco text-sm text-canaco-accent/70">{contacto_general.telefono}</span>
            </div>
          </div>
          <div class="p-4 rounded-xl border border-canaco-accent/10 bg-white">
            <span class="font-canaco text-xs font-bold uppercase tracking-wider text-canaco-accent/60 block mb-3">Teléfonos Expo Feria</span>
            <ul class="space-y-2">
              {contacto_general.telefonos_expo_feria.map((tel) => (
                <li key={tel} class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-canaco-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  <a href={`https://wa.me/52${tel.replace(/\s/g, '')}`} class="font-canaco text-sm font-bold text-canaco-accent hover:underline">{tel}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="flex flex-col items-center justify-center">
        <div class="w-full max-w-sm">
          <h3 class="font-canaco font-bold text-lg text-canaco-accent mb-4 text-center">QR de Afiliación</h3>
          <div class="flex flex-col items-center p-6 rounded-xl border border-canaco-accent/10 bg-white shadow-sm">
            <img src={qrUrl} alt="QR Afiliación CANACO" class="w-48 h-48 rounded-lg" />
            <p class="font-canaco text-sm text-canaco-accent/60 mt-4 text-center">
              Escanea para iniciar tu solicitud de membresía por WhatsApp
            </p>
            <a
              href={`https://wa.me/529999428850?text=${qrText}`}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-canaco-accent text-canaco-primary font-canaco font-bold text-sm uppercase tracking-wider hover:bg-canaco-accent-dk transition"
            >
              Afíliate por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</CanacoLayout>
