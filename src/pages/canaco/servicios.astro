---
// src/pages/canaco/servicios.astro — Catálogo de Servicios CANACO SERVYTUR Mérida
import CanacoLayout from '../../layouts/CanacoLayout.astro';
import { CANACO_CONTENT } from '../../data/canaco-content';

const { camara, catalogo_servicios } = CANACO_CONTENT;

// Agrupar servicios por departamento para navegación rápida
const departamentos = Array.from(
  new Map(
    catalogo_servicios.map((s) => [s.departamento, s.departamento])
  ).keys()
);
---

<CanacoLayout
  title={`${camara} · Catálogo de Servicios`}
  description="Catálogo de servicios de CANACO SERVYTUR Mérida: representación institucional, capacitación, renta de salones, publicidad, asuntos legales y más."
  url="/servicios"
  image="/images/canaco/stand-2x2.jpg"
>

  <!-- Hero -->
  <section class="relative min-h-[55vh] flex items-center justify-center overflow-hidden bg-canaco-primary text-canaco-accent px-6 py-12">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_25%,_rgba(26,58,92,0.08),_transparent_60%)]" />
    <div class="relative z-10 mx-auto max-w-4xl text-center animate-fade-up space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-canaco-accent/30 bg-canaco-accent/10 px-5 py-2 font-canaco text-[11px] font-bold uppercase tracking-[0.22em] text-canaco-accent backdrop-blur-sm">
        Catálogo de Servicios
      </span>
      <h1 class="font-canaco font-black text-4xl sm:text-5xl font-bold leading-[1.05] md:text-6xl tracking-tight">
        Servicios para Socios
      </h1>
      <p class="mx-auto max-w-2xl font-canaco text-lg leading-relaxed text-canaco-accent/80">
        Todo lo que CANACO SERVYTUR Mérida ofrece a sus afiliados: representación, capacitación, eventos, salones, publicidad, asesoría legal y bienestar social.
      </p>
    </div>
  </section>

  <!-- Filtro por departamento -->
  <section class="max-w-[1200px] mx-auto px-4 pt-12 pb-8">
    <div class="flex flex-wrap gap-2 justify-center mb-10">
      <button
        class="px-4 py-2 rounded-full bg-canaco-accent text-canaco-primary font-canaco font-bold text-sm uppercase tracking-wider hover:bg-canaco-accent-dk transition"
        data-depto="todos"
      >
        Todos ({catalogo_servicios.length})
      </button>
      {departamentos.map((d) => {
        const count = catalogo_servicios.filter((s) => s.departamento === d).length;
        return (
          <button
            key={d}
            class="px-4 py-2 rounded-full border border-canaco-accent/20 text-canaco-accent/70 font-canaco font-medium text-sm hover:bg-canaco-accent/5 hover:text-canaco-accent transition"
            data-depto={d}
          >
            {d} ({count})
          </button>
        );
      })}
    </div>
  </section>

  <!-- Servicios Grid -->
  <section id="servicios" class="max-w-[1200px] mx-auto px-4 pt-0 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {catalogo_servicios.map((svc) => (
        <article
          class="bg-white border border-canaco-accent/10 rounded-[24px] overflow-hidden hover:border-canaco-accent/40 hover:shadow-[0_20px_40px_rgba(26,58,92,0.08)] transition-all duration-300 flex flex-col"
          data-depto={svc.departamento}
        >
          <div class="p-6 flex-1 flex flex-col">
            <span class="font-canaco text-xs font-bold uppercase tracking-wider text-canaco-accent/60 block mb-2">
              {svc.departamento}
            </span>
            <h3 class="font-canaco font-bold text-[18px] text-canaco-accent mb-3 leading-tight">
              {svc.categoria}
            </h3>
            <p class="font-canaco text-sm text-canaco-accent/70 leading-relaxed mb-5 flex-1">
              {svc.descripcion}
            </p>
            {svc.contacto && (
              <div class="mt-auto pt-4 border-t border-canaco-accent/10 space-y-2">
                <span class="font-canaco text-[10px] font-bold uppercase tracking-wider text-canaco-accent/50 block mb-1">Contacto</span>
                {svc.contacto.persona && (
                  <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 text-canaco-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    <span class="font-canaco text-sm text-canaco-accent">{svc.contacto.persona}</span>
                  </div>
                )}
                {svc.contacto.telefono && (
                  <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 text-canaco-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    <a
                      href={`https://wa.me/52${svc.contacto.telefono.replace(/\D/g, '')}`}
                      target="_blank"
                      rel="noopener"
                      class="font-canaco text-sm font-bold text-canaco-accent hover:underline truncate"
                    >
                      {svc.contacto.telefono}
                    </a>
                  </div>
                )}
                {svc.contacto.email && (
                  <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 text-canaco-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <a
                      href={`mailto:${svc.contacto.email}`}
                      class="font-canaco text-sm font-bold text-canaco-accent hover:underline truncate"
                    >
                      {svc.contacto.email}
                    </a>
                  </div>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA Afiliación -->
  <section class="max-w-[1200px] mx-auto px-4 pt-16 pb-12">
    <div class="bg-canaco-accent rounded-[24px] p-8 md:p-12 text-canaco-primary text-center">
      <h2 class="font-canaco font-black text-3xl sm:text-4xl font-bold mb-4">
        ¿Quieres acceder a estos servicios?
      </h2>
      <p class="font-canaco text-lg mb-8 max-w-xl mx-auto text-canaco-primary/90">
        Conviértete en socio de CANACO SERVYTUR Mérida y accede a representación institucional, capacitación, salones, publicidad y más.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/529999428850?text=Quiero%20informaci%C3%B3n%20para%20afiliarme%20a%20CANACO%20SERVYTUR%20M%C3%A9rida"
          target="_blank"
          rel="noopener"
          class="px-8 py-4 rounded-full bg-canaco-primary text-canaco-accent font-canaco font-bold text-sm uppercase tracking-wider hover:brightness-105 transition flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Afíliate por WhatsApp
        </a>
        <a
          href="/canaco/contenido"
          class="px-8 py-4 rounded-full border-2 border-canaco-primary text-canaco-accent font-canaco font-bold text-sm uppercase tracking-wider hover:bg-canaco-primary/10 transition"
        >
          Ver Eventos y Patrocinios
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Filtro por departamento
    const buttons = document.querySelectorAll('[data-depto]');
    const cards = document.querySelectorAll('[data-depto]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const depto = btn.getAttribute('data-depto')!;
        buttons.forEach((b) => {
          b.classList.remove('bg-canaco-accent', 'text-canaco-primary');
          b.classList.add('border-canaco-accent/20', 'text-canaco-accent/70');
        });
        btn.classList.remove('border-canaco-accent/20', 'text-canaco-accent/70');
        btn.classList.add('bg-canaco-accent', 'text-canaco-primary');
        cards.forEach((card) => {
          if (depto === 'todos' || card.getAttribute('data-depto') === depto) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>

</CanacoLayout>
