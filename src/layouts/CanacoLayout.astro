---
// src/layouts/CanacoLayout.astro — Layout dedicado al tenant CANACO SERVYTUR Mérida
// HENEQUÉN design system: Fraunces tipografía, #FAF8F5 primario, #1A3A5C acento
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CartDrawer from '../components/checkout/CartDrawer.astro';
import { config } from '@config/config';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'CANACO SERVYTUR Mérida', description = 'Cámara Nacional de Comercio, Servicios y Turismo · Mérida, Yucatán' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FAF8F5" />
    <!-- PWA: instalación en móvil / offline -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="CANACO Mérida" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/ark-mascot.jpg" />
    <link rel="mask-icon" href="/favicon.svg" color="#1A3A5C" />
    <!-- Fuente: Fraunces (HENEQUÉN canon) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style>
      :root {
        --canaco-primary: #FAF8F5;
        --canaco-accent: #1A3A5C;
        --canaco-font: "Fraunces", Georgia, serif;
      }
      html { scroll-behavior: smooth; }
      body {
        font-family: var(--canaco-font);
        color: var(--canaco-accent);
        background-color: var(--canaco-primary);
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3, h4, .font-canaco {
        font-family: var(--canaco-font);
      }
    </style>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <CartDrawer />
    <script is:inline src="/widget.js" data-tenant="canaco"></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).then(() => {}).catch(() => {});
      }
    </script>
  </body>
</html>
