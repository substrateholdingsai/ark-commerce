---
// src/layouts/CanacoLayout.astro — Layout dedicado al tenant CANACO SERVYTUR Mérida
// HENEQUÉN design system: Fraunces tipografía, #FAF8F5 primario, #1A3A5C acento
import Header from '../components/layout/Header.astro';
import CanacoFooter from '../components/layout/CanacoFooter.astro';
import CartDrawer from '../components/checkout/CartDrawer.astro';
import { config } from '@config/config';

interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
}

const { 
  title = 'CANACO SERVYTUR Mérida', 
  description = 'Cámara Nacional de Comercio, Servicios y Turismo · Mérida, Yucatán',
  url = 'https://canaco.arksystems.site/',
  image = '/ark-mascot.jpg',
} = Astro.props;

const siteUrl = 'https://canaco.arksystems.site';
const ogImage = `${siteUrl}${image.startsWith('/') ? image : '/' + image}`;
const canonical = `${siteUrl}${url.startsWith('/') ? url.slice(1) : url}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FAF8F5" />
    <!-- PWA: instalación en móvil / offline -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="CANACO Mérida" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/ark-mascot.jpg" />
    <link rel="mask-icon" href="/favicon.svg" color="#1A3A5C" />
    <!-- SEO: canonical + Open Graph + Twitter Cards -->
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CANACO SERVYTUR Mérida" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- JSON-LD LocalBusiness structured data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "{canonical}#organization",
        "name": "CANACO SERVYTUR Mérida",
        "url": "{canonical}",
        "telephone": "+529999428850",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Mérida, Yucatán",
          "addressLocality": "Mérida",
          "addressRegion": "Yucatán",
          "addressCountry": "MX"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 20.9674,
          "longitude": -89.5925
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        "sameAs": [
          "https://wa.me/529999428850"
        ],
        "logo": "{ogImage}",
        "image": "{ogImage}"
      }
    </script>
    <!-- Fuente: Fraunces (HENEQUÉN canon) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style>
      :root {
        --canaco-primary: #FAF8F5;
        --canaco-accent: #1A3A5C;
        --canaco-font: "Fraunces", Georgia, serif;
      }
      html { scroll-behavior: smooth; }
      body {
        font-family: var(--canaco-font);
        color: var(--canaco-accent);
        background-color: var(--canaco-primary);
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3, h4, .font-canaco {
        font-family: var(--canaco-font);
      }
    </style>
  </head>
  <body>
    <Header />
    <slot />
    <CanacoFooter />
    <CartDrawer />
    <script is:inline src="/widget.js" data-tenant="canaco"></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).then(() => {}).catch(() => {});
      }
    </script>
  </body>
</html>
